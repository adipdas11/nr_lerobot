<?xml version="1.0"?>
<package format="3">
  <name>hand_teleoperation</name>
  <version>0.1.0</version>
  <description>Teleoperated robotic hand with MediaPipe and haptic feedback</description>
  <maintainer email="paumaria07@gmail.com">Pau M. Marcos Aguilar</maintainer>
  <license>MIT</license>

  <!-- add sensor_msgs, custom_msgs etc. as needed -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>hand_teleoperation_interfaces</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
